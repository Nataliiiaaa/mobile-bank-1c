&НаСервереПроцедура ДобавитьКартинкуНаСервере()    НовыйФайлКартинки = Справочники.Файлы.СоздатьЭлемент();    НовыйФайлКартинки.Файл = Новый ХранилищеЗначения(        ПолучитьИзВременногоХранилища(Фото));    Фото = ПоместитьВоВременноеХранилище(        НовыйФайлКартинки.Файл.Получить());    НовыйФайлКартинки.Записать();    Объект.Картинка = НовыйФайлКартинки.Ссылка;КонецПроцедуры   

&НаКлиентеАсинх Процедура ДобавитьКартинку(Команда)    Оповещение = Новый ОписаниеОповещения(        "ПослеВыбораФайла",        ЭтотОбъект);    НачатьПомещениеФайла(        Оповещение,        ,        ,        Истина);КонецПроцедуры&НаКлиентеАсинх Процедура ПослеВыбораФайла(    Результат,    Адрес,    ВыбранноеИмяФайла,    ДополнительныеПараметры) Экспорт    Если Результат Тогда        Фото = Адрес;        ДобавитьКартинкуНаСервере();    КонецЕсли;КонецПроцедуры
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Фото = ПолучитьНавигационнуюСсылку(Объект.Картинка, "Файл");Элементы.Фото.РазмерКартинки = РазмерКартинки.АвтоРазмер;
КонецПроцедуры
